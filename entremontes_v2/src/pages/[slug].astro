---
import Base from '../layouts/Base.astro';
import Downloads from '../components/Downloads.astro';
import { issues, getIssue } from '../data/issues.js';

export function getStaticPaths() {
	const paths = [];
	for (const issue of issues) {
		paths.push({ params: { slug: String(issue.number) }, props: { slug: String(issue.number) } });
		for (const article of issue.articles || []) {
			paths.push({ params: { slug: article.slug }, props: { slug: article.slug } });
		}
	}
	return paths;
}

const { slug } = Astro.props;
const issueNumber = parseInt(slug, 10);
const isIndex = !slug.includes('.');
const issue = getIssue(issueNumber);

const bodies = import.meta.glob('../content/articles/*.html', {
	query: '?raw',
	import: 'default',
	eager: true,
});
const fileFor = (s) => `../content/articles/${s}.html`;
const body = bodies[fileFor(slug)] ?? '';

/* Contexto de navegación del artículo dentro de su número */
let prev, next, position;
if (!isIndex) {
	if (issue.type === 'article') {
		position = 1;
	} else {
		const list = issue.articles;
		position = list.findIndex((a) => a.slug === slug) + 1;
		prev = list[position - 2];
		next = list[position];
	}
}

const kicker = isIndex ? `Número ${issue.number}` : `Número ${issue.number} · Artículo ${position}`;
const pageTitle = isIndex
	? `Nº ${issue.number} ${issue.title}`
	: issue.type === 'article'
		? issue.title
		: (issue.articles.find((a) => a.slug === slug)?.title ?? issue.title);
---

<Base title={pageTitle} description={issue.blurb.slice(0, 155)} ogImage={issue.cover}>
	{
		isIndex ? (
			<section class="issue-hero">
				<div class="wrap issue-hero-grid">
					<div class="issue-cover" data-reveal>
						<img src={issue.cover} alt={`Portada del número ${issue.number} de Entremontes`} width="480" height="640" />
					</div>
					<div class="issue-intro" data-reveal style="--reveal-delay:.12s">
						<p class="kicker">{kicker}</p>
						<h1>{issue.title}</h1>
						<p class="lead">{issue.blurb}</p>
						<Downloads downloads={issue.downloads} />
					</div>
				</div>
			</section>
		) : (
			<section class="article-head">
				<div class="wrap">
					<p class="kicker" data-reveal>
						{kicker}
					</p>
					<h1 data-reveal style="--reveal-delay:.08s">{pageTitle}</h1>
				</div>
			</section>
		)
	}

	{
		!isIndex && (
			<section class="wrap article-body">
				<article class="prose" set:html={body} />
			</section>
		)
	}

	{isIndex && issue.articles && (
		<section class="wrap issue-articles">
			<h2 class="section-title" data-reveal>Contenido del número</h2>
			<div class="articles-list">
				{issue.articles.map((a, i) => (
					<a class="article-row" href={`${a.slug}.html`} data-reveal style={`--reveal-delay:${i * 0.08}s`}>
						<span class="row-num">{String(i + 1).padStart(2, '0')}</span>
						<span class="row-body">
							<span class="row-title">{a.title}</span>
							{a.note && <span class="row-note">{a.note}</span>}
						</span>
						<span class="row-cta">Leer →</span>
					</a>
				))}
			</div>
		</section>
	)}

	<nav class="wrap pager" aria-label="Navegación entre artículos">
		<div class="pager-links">
			{prev ? (
				<a class="pager-link prev" href={`${prev.slug}.html`}>
					<span class="dir">← Anterior</span>
					<span class="ptitle">{prev.title}</span>
				</a>
			) : (
				<span />
			)}
			{next ? (
				<a class="pager-link next" href={`${next.slug}.html`}>
					<span class="dir">Siguiente →</span>
					<span class="ptitle">{next.title}</span>
				</a>
			) : null}
		</div>
		<a class="back-issue" href={issue.type === 'article' ? 'index.html' : `${issue.number}.html`}>
			{issue.type === 'article' ? '↑ Volver a la portada' : `↑ Índice del número ${issue.number}`}
		</a>
	</nav>
</Base>

<style>
	.issue-hero {
		padding-block: var(--space-xl) var(--space-l);
		border-bottom: 1px solid var(--line-soft);
		background:
			radial-gradient(900px 420px at 80% 0%, rgba(201, 162, 39, 0.07), transparent 65%),
			transparent;
	}

	.issue-hero-grid {
		display: grid;
		grid-template-columns: minmax(240px, 340px) 1fr;
		gap: clamp(1.5rem, 4vw, 3.5rem);
		align-items: start;
	}

	.issue-cover {
		position: relative;
		border: 1px solid var(--line);
		background: var(--surface);
		padding: 0.5rem;
		border-radius: var(--radius);
		box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5), inset 0 0 0 1px rgba(201, 162, 39, 0.08);
	}

	.issue-cover img {
		width: 100%;
		aspect-ratio: 3 / 4;
		object-fit: cover;
		filter: saturate(0.92) contrast(1.02);
	}

	.issue-intro h1 {
		font-size: clamp(2rem, 4.5vw, 3.1rem);
		margin-block: 0.9rem 1.1rem;
	}

	.lead {
		color: var(--muted);
		font-size: 1.05rem;
		line-height: 1.85;
		max-width: 62ch;
		margin-bottom: 1.8rem;
	}

	.article-head {
		padding-block: var(--space-xl) var(--space-m);
		text-align: center;
		background: radial-gradient(700px 300px at 50% 0%, rgba(201, 162, 39, 0.06), transparent 70%);
	}

	.article-head h1 {
		font-size: clamp(1.9rem, 4vw, 2.9rem);
		max-width: 22ch;
		margin-inline: auto;
	}

	.section-title {
		font-size: 1.6rem;
		color: var(--gold);
	}

	.article-body {
		padding-block: var(--space-l);
	}

	.issue-articles {
		padding-block: var(--space-l);
	}

	.articles-list {
		display: grid;
		gap: 0.75rem;
		margin-top: 1.25rem;
	}

	.article-row {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: baseline;
		gap: 1.2rem;
		padding: 1.15rem 1.35rem;
		background: var(--surface);
		border: 1px solid var(--line-soft);
		border-radius: var(--radius);
		text-decoration: none;
		transition: border-color 0.25s ease, transform 0.25s ease, background 0.25s ease;
	}

	.article-row:hover {
		border-color: var(--gold-dim);
		background: var(--surface-2);
		transform: translateX(4px);
	}

	.row-num {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--gold);
		letter-spacing: 0.14em;
	}

	.row-title {
		display: block;
		font-family: var(--font-display);
		font-size: 1.28rem;
		font-weight: 600;
		color: var(--paper);
		line-height: 1.3;
	}

	.article-row:hover .row-title {
		color: var(--gold);
	}

	.row-note {
		display: block;
		margin-top: 0.35rem;
		font-size: 0.85rem;
		color: var(--faint);
		font-style: italic;
	}

	.row-cta {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--faint);
	}

	.pager {
		margin-top: var(--space-l);
		border-top: 1px solid var(--line-soft);
		padding-top: var(--space-m);
		display: flex;
		flex-direction: column;
		gap: 1.2rem;
	}

	.pager-links {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	.pager-link {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding: 1rem 1.2rem;
		background: var(--surface);
		border: 1px solid var(--line-soft);
		border-radius: var(--radius);
		text-decoration: none;
	}

	.pager-link.next {
		text-align: right;
	}

	.pager-link:hover {
		border-color: var(--gold-dim);
	}

	.pager-link .dir {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--faint);
	}

	.pager-link .ptitle {
		font-family: var(--font-display);
		font-size: 1.05rem;
		font-weight: 600;
		color: var(--paper);
		line-height: 1.3;
	}

	.back-issue {
		align-self: center;
		font-family: var(--font-mono);
		font-size: 0.74rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--muted);
		text-decoration: none;
	}

	.back-issue:hover {
		color: var(--gold);
	}

	@media (max-width: 860px) {
		.issue-hero-grid {
			grid-template-columns: 1fr;
		}
		.issue-cover {
			max-width: 300px;
		}
		.pager-links {
			grid-template-columns: 1fr;
		}
	}
</style>
