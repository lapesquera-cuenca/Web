---
import Base from '../layouts/Base.astro';
import { issues } from '../data/issues.js';

const latest = issues[issues.length - 1];
const cards = [...issues].reverse();
---

<Base>
	{/* ---------- Hero ---------- */}
	<section class="hero">
		<img class="hero-bg" src="images/header.jpg" alt="" aria-hidden="true" loading="eager" decoding="async" />
		<div class="hero-inner wrap">
			<p class="kicker" data-reveal>Desde 2011 · El Manco de La Pesquera</p>
			<h1 data-reveal style="--reveal-delay:.1s">Entremontes</h1>
			<p class="hero-sub" data-reveal style="--reveal-delay:.2s">
				Revista digital de estudios del maquis. La lucha armada antifranquista en España,
				su dimensión social y humana, recuperada número a número.
			</p>
			<div class="hero-cta" data-reveal style="--reveal-delay:.3s">
				<a class="btn btn-solid" href={`${latest.number}.html`}>Leer el nº {latest.number}</a>
				<a class="btn btn-ghost" href="#numeros">Ver todos los números</a>
			</div>
		</div>
		<div class="hero-scroll" aria-hidden="true">↓</div>
	</section>

	{/* ---------- Último número ---------- */}
	<section class="wrap latest" id="novedades">
		<p class="kicker" data-reveal>Novedades</p>
		<div class="latest-grid">
			<a
				class="latest-cover"
				href={`${latest.number}.html`}
				data-reveal
				aria-label={`Número ${latest.number}: ${latest.title}`}
			>
				<img src={latest.cover} alt={`Portada del número ${latest.number}`} width="480" height="640" loading="lazy" decoding="async" />
			</a>
			<div class="latest-text" data-reveal style="--reveal-delay:.12s">
				<h2>
					Ya disponible el número <a href={`${latest.number}.html`}>{latest.number}</a>
				</h2>
				<p class="latest-title">{latest.title}</p>
				<p class="latest-blurb">{latest.blurb.slice(0, 320)}…</p>
				<a class="read-more" href={`${latest.number}.html`}>Leer este número →</a>
			</div>
		</div>
	</section>

	{/* ---------- Los números ---------- */}
	<section class="numbers-band" id="numeros">
		<div class="wrap">
			<p class="kicker" data-reveal>Colección completa</p>
			<h2 class="band-title" data-reveal style="--reveal-delay:.08s">Los diez números</h2>
		</div>
		<div class="reel" role="list">
			{
				cards.map((issue, i) => (
					<a class="num-card" role="listitem" href={`${issue.number}.html`} data-reveal style={`--reveal-delay:${Math.min(i * 0.06, 0.4)}s`}>
						<span class="num-tag">Nº {issue.number}</span>
						<img src={issue.cover} alt={`Portada del número ${issue.number}`} width="300" height="400" loading="lazy" decoding="async" />
						<span class="num-title">{issue.title}</span>
					</a>
				))
			}
		</div>
	</section>

	{/* ---------- Acerca de ---------- */}
	<section class="about" id="acerca">
		<div class="wrap about-grid">
			<div class="about-text" data-reveal>
				<p class="kicker">Acerca de…</p>
				<h2>Rehistorizar la guerrilla</h2>
				<p>
					En el año 2011 iniciamos <strong><em>Entremontes</em></strong>, revista digital de estudios del maquis,
					desde la web <a href="http://www.elmanco.es/">www.elmanco.es</a>. Han sido múltiples los haceres de
					proximidad con el esfuerzo y el reconocimiento histórico de la lucha armada antifranquista en España.
				</p>
				<p>
					Su contenido ha abordado los hechos, las vivencias, la documentación, las imágenes, la reparación,
					las leyes, el cine, la enseñanza, la búsqueda de desaparecidos y las exhumaciones. Rehistorización,
					en definitiva, como corresponde al esfuerzo por la recuperación de las libertades republicanas.
				</p>
				<p>
					Los tiempos de comunicación abierta nos permiten desligarnos de las ataduras del papel y ser más
					ágiles, más universales, sin ser menos rigurosos en formas y contenidos.
				</p>
				<p class="salute"><em>Salud y feliz día.</em></p>
			</div>

			<figure class="video-frame" data-reveal style="--reveal-delay:.15s">
				<div class="yt-facade" data-yt="fXh__gP_pIk" tabindex="0" role="button" aria-label="Reproducir: presentación de la revista Entremontes en las jornadas del Maquis de Santa Cruz de Moya 2013">
					<img src="https://i.ytimg.com/vi/fXh__gP_pIk/hqdefault.jpg" alt="" loading="lazy" decoding="async" />
					<span class="play" aria-hidden="true">▶</span>
				</div>
				<figcaption>Presentación en las Jornadas del Maquis de Santa Cruz de Moya, 2013.</figcaption>
			</figure>
		</div>
	</section>

	<script>
		document.querySelectorAll('.yt-facade').forEach((el) => {
			const load = () => {
				const id = el.getAttribute('data-yt');
				const iframe = document.createElement('iframe');
				iframe.width = '480';
				iframe.height = '270';
				iframe.src = `https://www.youtube-nocookie.com/embed/${id}?rel=0&autoplay=1`;
				iframe.title = el.getAttribute('aria-label') || 'Vídeo';
				iframe.allowFullscreen = true;
				iframe.allow = 'autoplay; encrypted-media; picture-in-picture';
				el.replaceWith(iframe);
			};
			el.addEventListener('click', load);
			el.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					load();
				}
			});
		});
	</script>
</Base>

<style>
	/* ---------- Hero ---------- */
	.hero {
		position: relative;
		min-height: calc(88vh - 72px);
		display: grid;
		place-items: center;
		text-align: center;
		overflow: hidden;
		border-bottom: 1px solid var(--line-soft);
	}

	.hero-bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: sepia(0.35) contrast(1.05) brightness(0.5);
		opacity: 0.28;
	}

	.hero::after {
		content: '';
		position: absolute;
		inset: 0;
		background:
			radial-gradient(1000px 500px at 50% 110%, rgba(207, 103, 70, 0.08), transparent 60%),
			radial-gradient(closest-side, transparent 40%, var(--bg) 130%),
			linear-gradient(180deg, rgba(16, 14, 11, 0.55), transparent 30%, rgba(22, 19, 16, 0.9));
	}

	.hero-inner {
		position: relative;
		z-index: 1;
		padding-block: var(--space-xl);
	}

	.hero h1 {
		font-size: clamp(3.2rem, 10vw, 7rem);
		font-weight: 700;
		letter-spacing: 0.06em;
		line-height: 1;
		margin-block: 1.2rem 1.4rem;
		color: var(--paper);
		text-shadow: 0 6px 60px rgba(0, 0, 0, 0.8);
	}

	.hero-sub {
		max-width: 46ch;
		margin-inline: auto;
		color: var(--muted);
		font-size: 1.08rem;
		line-height: 1.85;
	}

	.hero-cta {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
		margin-top: 2.2rem;
	}

	.btn {
		display: inline-block;
		padding: 0.85rem 1.9rem;
		border-radius: var(--radius);
		font-family: var(--font-mono);
		font-size: 0.74rem;
		font-weight: 500;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		text-decoration: none;
		transition: transform 0.25s ease, background 0.25s ease, border-color 0.25s ease, color 0.25s ease;
	}

	.btn-solid {
		background: var(--gold);
		color: var(--bg-deep);
		border: 1px solid var(--gold);
	}

	.btn-solid:hover {
		transform: translateY(-2px);
		background: #dcb63a;
		color: var(--bg-deep);
	}

	.btn-ghost {
		border: 1px solid var(--line);
		color: var(--paper);
	}

	.btn-ghost:hover {
		border-color: var(--gold-dim);
		color: var(--gold);
		transform: translateY(-2px);
	}

	.hero-scroll {
		position: absolute;
		bottom: 1.4rem;
		left: 50%;
		transform: translateX(-50%);
		z-index: 1;
		color: var(--faint);
		animation: bob 2.4s ease-in-out infinite;
		font-size: 1.1rem;
	}

	@keyframes bob {
		0%, 100% { translate: 0 0; opacity: 0.5; }
		50% { translate: 0 8px; opacity: 1; }
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-scroll { animation: none; }
	}

	/* ---------- Último número ---------- */
	.latest {
		padding-block: var(--space-xl);
	}

	.latest-grid {
		display: grid;
		grid-template-columns: minmax(240px, 360px) 1fr;
		gap: clamp(1.5rem, 5vw, 4rem);
		align-items: center;
		margin-top: 1.5rem;
	}

	.latest-cover {
		display: block;
		border: 1px solid var(--line);
		background: var(--surface);
		padding: 0.5rem;
		border-radius: var(--radius);
		box-shadow: 24px 24px 60px rgba(0, 0, 0, 0.45);
		transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s ease;
	}

	.latest-cover:hover {
		transform: translateY(-6px) rotate(-0.5deg);
		box-shadow: 30px 34px 80px rgba(0, 0, 0, 0.55);
	}

	.latest-cover img {
		width: 100%;
		aspect-ratio: 3 / 4;
		object-fit: cover;
	}

	.latest-text h2 {
		font-size: clamp(1.7rem, 3.5vw, 2.4rem);
		margin-top: 1rem;
	}

	.latest-text h2 a {
		color: var(--gold);
		text-decoration: none;
	}

	.latest-title {
		font-family: var(--font-display);
		font-style: italic;
		font-size: 1.25rem;
		color: var(--muted);
		margin-bottom: 1rem;
	}

	.latest-blurb {
		color: var(--muted);
		line-height: 1.85;
		margin-bottom: 1.5rem;
		max-width: 58ch;
	}

	.read-more {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--red);
	}

	.read-more:hover {
		color: var(--gold);
	}

	/* ---------- Números ---------- */
	.numbers-band {
		padding-block: var(--space-l) var(--space-xl);
		border-top: 1px solid var(--line-soft);
	}

	.band-title {
		font-size: clamp(1.8rem, 3.5vw, 2.5rem);
		margin-top: 0.8rem;
	}

	.reel {
		display: flex;
		gap: 1.1rem;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		padding: 1.75rem max(calc((100vw - 1180px) / 2 + clamp(1.25rem, 4vw, 3rem)), 1.25rem) 2rem;
		scrollbar-width: thin;
		scrollbar-color: var(--line) transparent;
	}

	.num-card {
		flex: 0 0 min(230px, 62vw);
		scroll-snap-align: start;
		position: relative;
		display: block;
		text-decoration: none;
		border-radius: var(--radius);
		overflow: hidden;
		border: 1px solid var(--line);
		background: var(--surface);
		transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.3s ease;
	}

	.num-card:hover {
		transform: translateY(-6px);
		border-color: var(--gold-dim);
	}

	.num-card img {
		width: 100%;
		aspect-ratio: 3 / 4;
		object-fit: cover;
		filter: saturate(0.85) brightness(0.92);
		transition: filter 0.4s ease, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.num-card:hover img {
		filter: saturate(1) brightness(1);
		transform: scale(1.04);
	}

	.num-tag {
		position: absolute;
		top: 0.8rem;
		left: 0.8rem;
		z-index: 1;
		font-family: var(--font-mono);
		font-size: 0.66rem;
		font-weight: 500;
		letter-spacing: 0.18em;
		color: var(--bg-deep);
		background: var(--gold);
		padding: 0.3em 0.75em;
		border-radius: 2px;
	}

	.num-title {
		position: absolute;
		inset-inline: 0;
		bottom: 0;
		padding: 2.4rem 1rem 0.95rem;
		background: linear-gradient(180deg, transparent, rgba(10, 8, 6, 0.94));
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.02rem;
		line-height: 1.3;
		color: var(--paper);
	}

	/* ---------- Acerca ---------- */
	.about {
		border-top: 1px solid var(--line-soft);
		padding-block: var(--space-xl);
		background: radial-gradient(800px 400px at 15% 20%, rgba(201, 162, 39, 0.05), transparent 60%);
	}

	.about-grid {
		display: grid;
		grid-template-columns: 1.15fr 1fr;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: start;
	}

	.about-text h2 {
		font-size: clamp(1.8rem, 3.5vw, 2.4rem);
		margin-block: 0.9rem 1.3rem;
		color: var(--paper);
	}

	.about-text p {
		color: var(--muted);
		margin-bottom: 1.2em;
		max-width: 56ch;
	}

	.about-text strong em,
	.about-text strong {
		color: var(--paper);
	}

	.salute {
		font-size: 1.05rem;
		color: var(--paper) !important;
	}

	.video-frame {
		margin: 0;
	}

	.yt-facade {
		position: relative;
		display: block;
		cursor: pointer;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		overflow: hidden;
		background: #000;
		box-shadow: 0 30px 60px rgba(0, 0, 0, 0.45);
	}

	.yt-facade img {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		filter: sepia(0.2) brightness(0.8);
		transition: filter 0.3s ease;
	}

	.yt-facade:hover img,
	.yt-facade:focus-visible img {
		filter: sepia(0) brightness(1);
	}

	.play {
		position: absolute;
		inset: 0;
		margin: auto;
		width: 4.2rem;
		height: 3rem;
		display: grid;
		place-items: center;
		background: rgba(177, 32, 20, 0.92);
		border-radius: 12px;
		color: #fff;
		font-size: 1.2rem;
		transition: transform 0.25s ease, background 0.25s ease;
	}

	.yt-facade:hover .play {
		transform: scale(1.08);
		background: var(--red-deep);
	}

	.video-frame iframe {
		width: 100%;
		aspect-ratio: 16 / 9;
		height: auto;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		display: block;
	}

	figcaption {
		margin-top: 0.8rem;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--faint);
	}

	@media (max-width: 860px) {
		.latest-grid,
		.about-grid {
			grid-template-columns: 1fr;
		}
		.latest-cover {
			max-width: 320px;
		}
	}
</style>
