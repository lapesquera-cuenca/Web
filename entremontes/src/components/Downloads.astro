---
const { downloads = [], heading = 'Descargar el número' } = Astro.props;
---

{
	downloads.length > 0 && (
		<div class="downloads">
			<span class="dl-label">{heading}</span>
			<div class="dl-buttons">
				{downloads.map((d) => (
					<a class="dl-btn" href={`doc/${encodeURIComponent(d.file)}`} download>
						<span class="fmt">{d.label}</span>
						<span class="size">{d.file}</span>
					</a>
				))}
			</div>
		</div>
	)
}

<style>
	.downloads {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		flex-wrap: wrap;
		padding: 1.1rem 1.35rem;
		background: var(--surface);
		border: 1px solid var(--line);
		border-left: 2px solid var(--gold);
		border-radius: var(--radius);
	}

	.dl-label {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 500;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.dl-buttons {
		display: flex;
		gap: 0.7rem;
		flex-wrap: wrap;
	}

	.dl-btn {
		display: inline-flex;
		align-items: baseline;
		gap: 0.6em;
		padding: 0.55rem 1rem;
		border: 1px solid var(--gold-dim);
		border-radius: var(--radius);
		text-decoration: none;
		transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
	}

	.dl-btn:hover {
		background: rgba(201, 162, 39, 0.08);
		border-color: var(--gold);
		transform: translateY(-1px);
	}

	.fmt {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		font-weight: 500;
		letter-spacing: 0.16em;
		color: var(--gold);
		text-transform: uppercase;
	}

	.size {
		font-family: var(--font-mono);
		font-size: 0.66rem;
		color: var(--faint);
	}
</style>
