---
import { issues } from '../data/issues.js';

const path = Astro.url.pathname.split('/').pop() || 'index.html';
const onHome = path === 'index.html' || path === '';
---

<header class="site-header">
	<div class="wrap header-inner">
		<a class="brand" href="index.html" aria-label="Entremontes — portada">
			<span class="brand-mark" aria-hidden="true">E·M</span>
			<span class="brand-text">
				<span class="brand-name">Entremontes</span>
				<span class="brand-sub">Revista digital de estudios del maquis</span>
			</span>
		</a>

		<nav class="site-nav" aria-label="Navegación principal">
			<a href="index.html" aria-current={onHome ? 'page' : undefined}>Portada</a>

			<details class="menu-numbers">
				<summary>Números<span class="caret" aria-hidden="true"></span></summary>
				<ul class="numbers-panel">
					{
						issues.map((issue) => (
							<li>
								<a href={`${issue.number}.html`}>
									<span class="num">Nº {issue.number}</span>
									<span class="title">{issue.title}</span>
								</a>
							</li>
						))
					}
				</ul>
			</details>

			<a href={onHome ? '#acerca' : 'index.html#acerca'}>Acerca de</a>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(16, 14, 11, 0.88);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--line-soft);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-m);
		min-height: 72px;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		text-decoration: none;
		color: var(--paper);
	}

	.brand-mark {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.05rem;
		letter-spacing: 0.08em;
		color: var(--gold);
		border: 1px solid var(--gold-dim);
		border-radius: 50%;
		width: 2.6rem;
		height: 2.6rem;
		display: grid;
		place-items: center;
		flex: none;
	}

	.brand-text {
		display: flex;
		flex-direction: column;
		line-height: 1.25;
	}

	.brand-name {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.35rem;
		letter-spacing: 0.04em;
	}

	.brand-sub {
		font-family: var(--font-mono);
		font-size: 0.58rem;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.site-nav {
		display: flex;
		align-items: center;
		gap: clamp(1rem, 3vw, 2rem);
	}

	.site-nav > a,
	.menu-numbers summary {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		font-weight: 500;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--muted);
		text-decoration: none;
		cursor: pointer;
		list-style: none;
		display: inline-flex;
		align-items: center;
		gap: 0.45em;
		transition: color 0.2s ease;
		padding-block: 0.5rem;
	}

	.site-nav > a:hover,
	.menu-numbers summary:hover,
	.menu-numbers[open] summary {
		color: var(--gold);
	}

	.site-nav > a[aria-current='page'] {
		color: var(--paper);
	}

	.caret {
		width: 0.4em;
		height: 0.4em;
		border-right: 1px solid currentColor;
		border-bottom: 1px solid currentColor;
		transform: rotate(45deg) translateY(-0.1em);
		transition: transform 0.2s ease;
	}

	.menu-numbers[open] .caret {
		transform: rotate(225deg) translateY(-0.05em);
	}

	.menu-numbers {
		position: relative;
	}

	.numbers-panel {
		position: absolute;
		right: min(-1rem, -1vw);
		top: calc(100% + 0.6rem);
		margin: 0;
		padding: 0.5rem;
		list-style: none;
		min-width: 300px;
		max-width: min(380px, calc(100vw - 3rem));
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		box-shadow: 0 24px 48px rgba(0, 0, 0, 0.55);
	}

	.numbers-panel::before {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		box-shadow: inset 0 1px 0 rgba(201, 162, 39, 0.12);
		pointer-events: none;
	}

	.numbers-panel a {
		display: flex;
		gap: 0.9rem;
		align-items: baseline;
		padding: 0.55rem 0.7rem;
		border-radius: var(--radius);
		text-decoration: none;
		color: var(--paper);
	}

	.numbers-panel a:hover {
		background: var(--surface-2);
		color: var(--gold);
	}

	.numbers-panel .num {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.14em;
		color: var(--gold);
		flex: none;
		width: 3.2em;
	}

	.numbers-panel .title {
		font-family: var(--font-body);
		font-size: 0.86rem;
		line-height: 1.4;
	}

	@media (max-width: 720px) {
		.brand-sub {
			display: none;
		}
		.header-inner {
			min-height: 60px;
		}
		.brand-name {
			font-size: 1.15rem;
		}
		.numbers-panel {
			right: -4rem;
		}
	}
</style>
